# Nightglass production geometry: Waveshare 2.06 V1.0, ESP32-S3R8, 32 MB flash.
CONFIG_ESPTOOLPY_FLASHMODE_QIO=y
CONFIG_NIGHTGLASS_AUDIO_ENABLED=y
CONFIG_NIGHTGLASS_AUDIO_BOOT_SELF_TEST=n
CONFIG_ESPTOOLPY_FLASHSIZE_32MB=y
CONFIG_PARTITION_TABLE_CUSTOM=y
CONFIG_PARTITION_TABLE_CUSTOM_FILENAME="partitions.csv"
CONFIG_PARTITION_TABLE_OFFSET=0x8000

CONFIG_ESP_DEFAULT_CPU_FREQ_MHZ_240=y
CONFIG_PM_ENABLE=y
CONFIG_PM_DFS_INIT_AUTO=y
CONFIG_PM_SLP_IRAM_OPT=y
CONFIG_PM_RTOS_IDLE_OPT=y
CONFIG_SPIRAM=y
CONFIG_SPIRAM_MODE_OCT=y
CONFIG_SPIRAM_SPEED_80M=y
CONFIG_SPIRAM_FETCH_INSTRUCTIONS=y
CONFIG_SPIRAM_RODATA=y
CONFIG_ESP32S3_DATA_CACHE_LINE_64B=y
# Keep display transfers bounded after activity, Wi-Fi, and BLE tasks allocate
# their stacks. An 8-row RGB565 chunk is 6,560 bytes; the reserved internal
# pool keeps that DMA bounce buffer available without starving radio services.
# BLE modem sleep/PM adds controller bookkeeping in internal RAM. Preserve
# enough contiguous DMA-capable memory for the 32-row AMOLED bounce buffer
# after the radio and service tasks start.
CONFIG_SPIRAM_MALLOC_RESERVE_INTERNAL=98304
CONFIG_BSP_DISPLAY_LVGL_BUF_HEIGHT=8

CONFIG_COMPILER_OPTIMIZATION_PERF=y
CONFIG_APP_REPRODUCIBLE_BUILD=y
CONFIG_FREERTOS_HZ=1000
CONFIG_FREERTOS_USE_TICKLESS_IDLE=y
CONFIG_FREERTOS_IDLE_TIME_BEFORE_SLEEP=3
CONFIG_ESP_TASK_WDT_EN=y
CONFIG_ESP_TASK_WDT_INIT=y
CONFIG_MBEDTLS_CERTIFICATE_BUNDLE=y
CONFIG_MBEDTLS_CERTIFICATE_BUNDLE_DEFAULT_FULL=y

CONFIG_BOOTLOADER_APP_ROLLBACK_ENABLE=y
CONFIG_BOOTLOADER_APP_ANTI_ROLLBACK=n
CONFIG_NIGHTGLASS_OTA_ENABLED=y
# The matching private key is sealed outside the repository. This public SEC1
# point is intentionally visible and is verified by the release gate.
CONFIG_NIGHTGLASS_OTA_P256_PUBLIC_KEY_HEX="044e501e8b18a69dcc61a4a32d1e52d0f8ff65aa635986bf144d62d3704466f67f64729c6eda70fd2ee5ba2f2a102d8a8d94ee0a48ba44eca679507a8fdb65e7d0"
CONFIG_NIGHTGLASS_OTA_ALLOW_UNSIGNED_DEVELOPMENT=n
CONFIG_NIGHTGLASS_OTA_HIL_FORCE_HEALTH_FAILURE=n
# Production watches must not retain arbitrary task stacks, notification text,
# or companion state in a persistent flash coredump. Recovery diagnostics use
# bounded health/status records instead.
CONFIG_ESP_COREDUMP_ENABLE_TO_NONE=y

# Nightglass companion radio: BLE-only NimBLE peripheral with bonded LE Secure
# Connections. Application characteristics additionally require encryption.
CONFIG_BT_ENABLED=y
CONFIG_BT_BLUEDROID_ENABLED=n
CONFIG_BT_NIMBLE_ENABLED=y
CONFIG_BT_NIMBLE_HOST_TASK_STACK_SIZE=8192
CONFIG_BT_NIMBLE_ROLE_CENTRAL=n
CONFIG_BT_NIMBLE_ROLE_PERIPHERAL=y
CONFIG_BT_NIMBLE_ROLE_BROADCASTER=y
CONFIG_BT_NIMBLE_ROLE_OBSERVER=n
CONFIG_BT_NIMBLE_GATT_CLIENT=n
CONFIG_BT_NIMBLE_GATT_SERVER=y
CONFIG_BT_NIMBLE_MAX_CONNECTIONS=1
CONFIG_BT_NIMBLE_SECURITY_ENABLE=y
CONFIG_BT_NIMBLE_SM_SC=y
CONFIG_BT_NIMBLE_SM_SC_DEBUG_KEYS=n
CONFIG_BT_NIMBLE_LL_CFG_FEAT_LE_ENCRYPTION=y
CONFIG_BT_NIMBLE_NVS_PERSIST=y
CONFIG_BT_CTRL_MODEM_SLEEP=y
CONFIG_BT_CTRL_MODEM_SLEEP_MODE_1=y
CONFIG_BT_CTRL_LPCLK_SEL_MAIN_XTAL=y
CONFIG_BT_CTRL_MAIN_XTAL_PU_DURING_LIGHT_SLEEP=y
CONFIG_BT_CTRL_RUN_IN_FLASH_ONLY=y
CONFIG_USJ_NO_AUTO_LS_ON_CONNECTION=y
CONFIG_LV_USE_CLIB_MALLOC=y
CONFIG_LV_USE_CLIB_STRING=y
CONFIG_LV_USE_CLIB_SPRINTF=y
CONFIG_LV_DEF_REFR_PERIOD=30
CONFIG_LV_OS_FREERTOS=y
CONFIG_LV_DRAW_SW_DRAW_UNIT_CNT=2
CONFIG_LV_ATTRIBUTE_FAST_MEM_USE_IRAM=y
CONFIG_LV_FONT_MONTSERRAT_14=y
CONFIG_LV_FONT_MONTSERRAT_16=y
CONFIG_LV_FONT_MONTSERRAT_18=y
CONFIG_LV_FONT_MONTSERRAT_20=y
CONFIG_LV_FONT_MONTSERRAT_24=y
CONFIG_LV_FONT_MONTSERRAT_26=y
CONFIG_LV_FONT_MONTSERRAT_32=y
CONFIG_LV_FONT_MONTSERRAT_48=y
CONFIG_LV_USE_FONT_COMPRESSED=y
CONFIG_LV_TXT_BREAK_CHARS=" ,.;:-_"
# Nightglass ships its own shell; upstream demo/example translation units are
# development baggage and must not enter production builds.
# CONFIG_LV_BUILD_EXAMPLES is not set
# CONFIG_LV_BUILD_DEMOS is not set
